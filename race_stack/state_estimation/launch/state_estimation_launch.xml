<?xml version="1.0"?>
<launch>
    <arg name="mapping_bool"    default="True"/>
    <arg name="racecar_version" default="NUC2"/>
    <arg name="map_name"        default="hangar" />
    <arg name="frenet_bool"     default="False" />
    <arg name="skip_early_fusion" default="False" />
    <arg name="use_sim_time"    default="False" />
    <arg name="loc_algorithm"   default="slam"
         description="Localization algorithm: slam | synpf"/>

    <!-- EKF IMU + Odom Fusion - runs for both slam and synpf -->
    <group unless="$(var skip_early_fusion)">
        <include file="$(find-pkg-share state_estimation)/launch/ekf_launch.py"/>
    </group>

    <!--  LOCALIZATION -->
    <arg name="slam_config_path" default="$(find-pkg-share stack_master)/config/$(var racecar_version)/slam" />
    <let name="map_path" value="$(find-pkg-share stack_master)/maps/$(var map_name)" />

    <!-- ================================================================== -->
    <!-- SLAM (Cartographer) - only when loc_algorithm == slam              -->
    <!-- ================================================================== -->
    <group if="$(eval '\'$(var loc_algorithm)\' == \'slam\'')">

        <!-- IF SLAM LOC ONLY -->
        <group unless="$(var mapping_bool)">
            <node name="cartographer_node" pkg="cartographer_ros"
                exec="cartographer_node"
                args="-configuration_directory $(var slam_config_path) -configuration_basename f110_2d_loc.lua -load_state_filename $(var map_path)/$(var map_name).pbstream --minloglevel 0">
                <remap from="odom" to="early_fusion/odom" />
                <param name="use_sim_time" value="$(var use_sim_time)" />
            </node>

            <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
                exec="cartographer_occupancy_grid_node" args="-resolution 0.05">
                <param name="use_sim_time" value="$(var use_sim_time)" />
            </node>

            <node pkg="nav2_map_server" name="map_server" exec="map_server" output="screen">
                <param name="yaml_filename" value="$(var map_path)/$(var map_name).yaml" />
                <param name="use_sim_time" value="$(var use_sim_time)" />
            </node>
            <node pkg="nav2_lifecycle_manager" name="lifecycle_manager" exec="lifecycle_manager"
                output="screen">
                <param name="autostart" value="True" />
                <param name="node_names" value="[map_server]" />
                <param name="use_sim_time" value="$(var use_sim_time)" />
            </node>
        </group>

        <!-- ELIF SLAM MAPPING -->
        <group if="$(var mapping_bool)">
            <node name="cartographer_node" pkg="cartographer_ros"
                exec="cartographer_node"
                args="-configuration_directory $(var slam_config_path) -configuration_basename f110_2d.lua --minloglevel 0">
                <remap from="odom" to="early_fusion/odom" />
                <param name="use_sim_time" value="$(var use_sim_time)" />
            </node>

            <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
                exec="cartographer_occupancy_grid_node" args="-resolution 0.05">
                <param name="use_sim_time" value="$(var use_sim_time)" />
            </node>
        </group>

    </group>

    <!-- ================================================================== -->
    <!-- SynPF - only when loc_algorithm == synpf                          -->
    <!-- Cartographer is NOT launched; PF broadcasts map->base_link TF     -->
    <!-- ================================================================== -->
    <group if="$(eval '\'$(var loc_algorithm)\' == \'synpf\'')">
        <node pkg="state_estimation" exec="synpf_node" name="synpf_node" output="screen">
            <param name="map_yaml_path"
                   value="$(find-pkg-share stack_master)/maps/$(var map_name)/pf_map.yaml"/>
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <!-- Load default params then allow per-car overrides -->
            <param from="$(find-pkg-share state_estimation)/config/synpf_params.yaml"/>
        </node>
    </group>

    <!-- Carstate Node - always runs regardless of localization algorithm.
         use_sim_time is forced False even in sim: carstate's create_timer
         callbacks must fire on wall clock. If gym's /clock publisher misses a
         tick, sim time stalls and timer-driven publishes silently stop —
         carstate doesn't need sim-time alignment for its TF lookups. -->
    <node name="carstate_node" pkg="state_estimation" exec="carstate_node" args="" output='screen'>
        <remap from="/odom_out" to="/car_state/odom" />
        <param name="frenet_bool" value="$(var frenet_bool)" />
        <param name="use_sim_time" value="False" />
        
        <!-- synpf: TF is map -> car_state/base_link; slam: map -> base_link -->
        <param name="base_frame_id" 
               value="$(eval '\'car_state/base_link\' if \'$(var loc_algorithm)\' == \'synpf\' else \'base_link\'')"/>

        <!-- sim: EKF has no input; use raw gym odom for velocity instead -->
        <param name="odom_topic" 
               value="$(eval '\'/car_state/odom\' if \'$(var use_sim_time)\' == \'True\' else \'/odom\'')"/>
        <param name="odom_out_topic" value="/car_state/odom" />
        <param name="pose_out_topic" value="/car_state/pose" />
    </node>

</launch>

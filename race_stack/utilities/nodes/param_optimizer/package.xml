<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>param_optimizer</name>
  <version>0.0.1</version>
  <description>
    Bayesian optimisation of MAP controller and sector scaler parameters.
    Replaces bayesopt4ros from the ROS1 stack.
    Backend: scikit-optimize (GP + Expected Improvement).
    Python dep: pip install scikit-optimize
  </description>
  <maintainer email="abhinav@iitd.ac.in">Abhinav</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>f110_msgs</depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
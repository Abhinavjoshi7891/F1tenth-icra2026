<launch>
    <arg name="param_file" description="Filepath to the opponent tracking/detection config file" />
    <arg name="perception_algorithm" default="ABD" description="ABD, Norfair, or CenterSpeed" />

    <node pkg="perception" name="detect" exec="detect" output="log"
        args="--ros-args --log-level info">
        <param from= "$(var param_file)" />
    </node>

    <group if="$(eval '\'$(var perception_algorithm)\' == \'ABD\'')">
        <node pkg="perception" name="tracking" exec="tracking" output="log"
            args="--ros-args --log-level warn">
            <param from= "$(var param_file)" />
        </node>
    </group>

    <group if="$(eval '\'$(var perception_algorithm)\' == \'Norfair\'')">
        <node pkg="perception" name="norfair" exec="norfair" output="screen"
            args="--ros-args --log-level info">
            <param from= "$(var param_file)" />
        </node>
    </group>

    <group if="$(eval '\'$(var perception_algorithm)\' == \'CenterSpeed\'')">
        <node pkg="perception" name="centerspeed" exec="centerspeed" output="screen"
            args="--ros-args --log-level info">
            <param from= "$(var param_file)" />
        </node>
    </group>
</launch>
# Deployment image for Jetson Orin Nano — JetPack 6.2 (L4T R36.5.0)
# If this tag is unavailable, check hub.docker.com/r/dustynv/ros/tags and use closest r36.x.x
FROM dustynv/ros:humble-ros-base-l4t-r36.3.0

ENV SHELL=/bin/bash \
    ROS_DOMAIN_ID=48 \
    DEBIAN_FRONTEND=noninteractive \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Replace stale ROS2 apt key (expired in base image) with fresh one
RUN rm -f /etc/apt/sources.list.d/ros2*.list \
    && rm -f /usr/share/keyrings/ros-archive-keyring.gpg \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc -o /tmp/ros.asc \
    && gpg --batch --dearmor < /tmp/ros.asc > /usr/share/keyrings/ros-archive-keyring.gpg \
    && rm /tmp/ros.asc \
    && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" \
       > /etc/apt/sources.list.d/ros2.list

# Build tools needed for C++ packages (vesc_driver, f110_msgs, ackermann_mux)
# ros-humble-ament-cmake-auto: required by vesc_msgs, f110_msgs, teleop_tools_msgs CMakeLists
# ros-humble-ament-cmake-python: required for packages mixing C++ and Python
RUN apt-get update && apt-get install -y \
    cmake \
    build-essential \
    python3-colcon-common-extensions \
    ros-humble-ament-cmake-auto \
    ros-humble-ament-cmake-python \
    && rm -rf /var/lib/apt/lists/*

# apt dependencies
COPY .install_utils/linux_req/linux_req.txt /tmp/linux_req.txt
RUN apt-get update && xargs apt-get install -y < /tmp/linux_req.txt \
    && rm -rf /var/lib/apt/lists/* /tmp/linux_req.txt

# Use standard PyPI — dustynv base points pip at Jetson-only index (jetson.webredirect.org)
ENV PIP_INDEX_URL=https://pypi.org/simple

# Python dependencies — exact versions from dev machine (pip3 freeze 2026-05-08)
# transforms3d installed with --ignore-installed: base has distutils-installed 0.3.1 pip cannot uninstall
COPY .install_utils/python_req_deploy.txt /tmp/python_req_deploy.txt
RUN pip3 install --ignore-installed transforms3d==0.4.2 \
    && pip3 install -r /tmp/python_req_deploy.txt \
    && pip3 install quadprog==0.1.7 \
    && rm /tmp/python_req_deploy.txt

# range_libc with CUDA enabled — GPU ray casting for particle filter on Jetson
RUN apt-get update && apt-get install -y git python3-dev cython3 \
    && git clone --depth 1 https://github.com/f1tenth/range_libc.git /tmp/range_libc \
    && cd /tmp/range_libc/pywrapper \
    && WITH_CUDA=ON python3 setup.py install \
    && rm -rf /tmp/range_libc \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace source into image
COPY race_stack/ /ros2_ws/src/

# Install local Python package bundled inside global_planner (not a ROS package, colcon won't install it)
RUN pip3 install /ros2_ws/src/planner/global_planner/global_planner/global_racetrajectory_optimization/

WORKDIR /ros2_ws

# Build workspace
# --packages-skip: f110_gym and f1tenth_gym_ros are simulator packages, not needed on physical car
# --parallel-workers 2: limits C++ parallel compilation to avoid OOM on 7.4GB Jetson RAM
RUN . /opt/ros/humble/setup.sh \
    && export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    && colcon build --symlink-install \
        --cmake-args -DBUILD_TESTING=OFF \
        --packages-skip f110_gym f1tenth_gym_ros \
        --parallel-workers 2

COPY docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

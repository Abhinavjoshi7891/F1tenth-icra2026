<launch>
    <!-- Trajectory to follow: centerline / min_curv / shortest_path -->
    <arg name="trajectory"   default="min_curv"/>
    <!-- Starting s-coordinate along the track [m] -->
    <arg name="start_s"      default="0.0"/>

    <!-- Speed profile selection: const / raceline / sine / step -->
    <arg name="speed_type"   default="raceline"/>
    <!-- Base speed used by 'const' and as the mean for 'sine' [m/s] -->
    <arg name="speed"        default="1.0"/>
    <!-- Scale factor applied on top of raceline speed (used by 'raceline') -->
    <arg name="speed_scaler" default="0.5"/>

    <!-- Sine speed profile parameters (only active when speed_type:=sine) -->
    <arg name="ampl_sin1"    default="0.3"/>
    <arg name="ampl_sin2"    default="0.0"/>
    <arg name="phase_sin1"   default="4.0"/>
    <arg name="phase_sin2"   default="3.0"/>

    <!-- Publisher mode: virtual (ObstacleArray only) / lidar (also paints map) -->
    <!-- NOTE: ObstacleArray is ALWAYS published regardless of this setting.   -->
    <!-- 'lidar' additionally draws the obstacle on the /map occupancy grid.   -->
    <arg name="type"         default="virtual"/>

    <!-- Launch Collision Detector -->
    <node name="collision_detector" pkg="opponent_publisher" exec="collision_detector" output="screen"/>

    <!-- Launch Obstacle Publisher -->
    <node name="obstacle_publisher" pkg="opponent_publisher" exec="obstacle_publisher" output="screen">
        <param name="trajectory"   value="$(var trajectory)"/>
        <param name="start_s"      value="$(var start_s)"/>
        <param name="speed_type"   value="$(var speed_type)"/>
        <param name="speed"        value="$(var speed)"/>
        <param name="speed_scaler" value="$(var speed_scaler)"/>
        <param name="ampl_sin1"    value="$(var ampl_sin1)"/>
        <param name="ampl_sin2"    value="$(var ampl_sin2)"/>
        <param name="phase_sin1"   value="$(var phase_sin1)"/>
        <param name="phase_sin2"   value="$(var phase_sin2)"/>
        <param name="type"         value="$(var type)"/>
    </node>

</launch>
